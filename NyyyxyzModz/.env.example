NODE_ENV="development"

# Prisma/PostgreSQL. DIRECT_URL is used by Prisma for direct database operations.
DATABASE_URL="your_database_url"
DIRECT_URL="your_direct_database_url"

# Seeded admin identity. Use a bcrypt hash, never a plaintext password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="your_bcrypt_password_hash"

# Public values safe to expose in browser-rendered pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_WHATSAPP_1="your_admin_whatsapp_number"
NEXT_PUBLIC_ADMIN_WHATSAPP_2="your_second_admin_whatsapp_number"

# Optional Resend email provider. Leave unset to keep email features disabled.
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM="NyyyxyzModz <onboarding@resend.dev>"

# Optional Supabase Storage server-side upload configuration.
SUPABASE_URL="your_supabase_project_url"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_STORAGE_BUCKET="media"

# Vercel Cron bearer secret. Required for protected production cleanup requests.
CRON_SECRET="generate_a_secure_random_secret"
